{
  "name": "tars-gesture-robotics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TARS — gesture-controlled robotic arm simulation (webcam hand tracking + 6-DOF kinematics)",
  "scripts": {
    "setup:assets": "node scripts/setup-assets.mjs",
    "postinstall": "node scripts/setup-assets.mjs --wasm-only",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/tektur": "^5.3.0",
    "@fontsource/ibm-plex-mono": "5.1.0",
    "@fontsource/inter-tight": "^5.1.0",
    "@fontsource/michroma": "^5.1.0",
    "@mediapipe/tasks-vision": "0.10.14",
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
